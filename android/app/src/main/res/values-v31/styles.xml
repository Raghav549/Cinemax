<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 31+: the platform splash screen is dressed with the Cinemax gradient
      and emblem so the system splash and the in-app splash read as one motion.
    -->
    <style name="CinemaxAppTheme.Base.V31" parent="@style/CinemaxAppTheme.Base.V28">
        <item name="android:windowSplashScreenBackground">@color/cinemax_ink_soft</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/cinemax_emblem</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/cinemax_plum</item>
        <item name="android:windowSplashScreenAnimationDuration">320</item>
    </style>

    <style name="CinemaxAppTheme" parent="@style/CinemaxAppTheme.Base.V31" />
</resources>
