<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch window: deep near-black with the Cinemax logo centred, so the
  cold-start surface (and the API 31+ system splash) already shows the logo the
  in-app reveal starts from. It is deliberately flat ink - the app's own reveal
  brings the white / silver lighting up over it, so nothing flashes.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#030303"
                android:endColor="#020202"
                android:startColor="#020202"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:width="128dp"
        android:height="128dp"
        android:drawable="@drawable/cinemax_emblem"
        android:gravity="center" />
</layer-list>
