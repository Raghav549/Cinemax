<?xml version="1.0" encoding="utf-8"?>
<!-- Near-black cinema canvas with restrained logo-colour light (offline surface). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#090910"
                android:endColor="#050507"
                android:startColor="#050507"
                android:type="linear" />
        </shape>
    </item>

    <item android:alpha="0.34">
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.28"
                android:centerY="0.25"
                android:endColor="#005E96FF"
                android:gradientRadius="540dp"
                android:startColor="#5E96FF"
                android:type="radial" />
        </shape>
    </item>

    <item android:alpha="0.26">
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.76"
                android:centerY="0.58"
                android:endColor="#00EF76CB"
                android:gradientRadius="500dp"
                android:startColor="#EF76CB"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
