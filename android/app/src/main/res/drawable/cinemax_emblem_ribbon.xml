<?xml version="1.0" encoding="utf-8"?>
<!--
  Cinemax aperture emblem - ribbon layer.

  The exact artwork and gradients of drawable/cinemax_emblem.xml, split into its
  two light ribbons so the native splash can reveal them in layers (the same
  layering the website's intro uses: the folded "C" first, the fold second).
  Path data and gradients are copied verbatim from cinemax_emblem.xml, which
  remains the single source of truth for the logo (app icon, launch window and
  the error screen keep using it unchanged).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="160dp"
    android:height="160dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <path android:pathData="M42.2,5.8 L12.8,22.5 A10.9,10.9 0 0,0 12.8,41.5 L42.2,58.2 L51.8,46.9 L25.7,32 L51.8,17.1 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="42"
                android:endY="58"
                android:startX="10"
                android:startY="12"
                android:type="linear">
                <item android:color="#70E0FF" android:offset="0" />
                <item android:color="#4479FF" android:offset="0.36" />
                <item android:color="#8355FF" android:offset="0.7" />
                <item android:color="#BE65F7" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M42.1,6.6 L13.3,23 A10.3,10.3 0 0,0 8.2,31.9"
        android:strokeColor="#99A2ECFF"
        android:strokeWidth="1.1" />
</vector>
