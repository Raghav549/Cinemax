<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cinemax_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cinemax_ink">

    <!-- The production Cinemax web app runs here. The container lets the shell
         rebuild the WebView in place if a renderer process ever goes away. -->
    <FrameLayout
        android:id="@+id/cinemax_web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HTML5 video / provider embeds expand into this surface. -->
    <FrameLayout
        android:id="@+id/cinemax_fullscreen_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <!-- Only shown while a real navigation is in progress, never as splash chrome. -->
    <ProgressBar
        android:id="@+id/cinemax_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/cinemax_page_progress"
        android:visibility="invisible" />

    <!-- Native cinematic intro. It hands over after a themed first paint or a
         short safety timeout; there is intentionally no spinner/loading copy. -->
    <FrameLayout
        android:id="@+id/cinemax_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cinemax_splash_background">

        <View
            android:id="@+id/cinemax_splash_glow"
            android:layout_width="330dp"
            android:layout_height="330dp"
            android:layout_gravity="center"
            android:background="@drawable/cinemax_splash_glow" />

        <View
            android:id="@+id/cinemax_splash_ring_one"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_gravity="center"
            android:background="@drawable/cinemax_splash_ring" />

        <View
            android:id="@+id/cinemax_splash_ring_two"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:background="@drawable/cinemax_splash_ring_inner" />

        <View
            android:id="@+id/cinemax_splash_streak_one"
            android:layout_width="520dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="@drawable/cinemax_splash_light_streak"
            android:rotation="-24" />

        <View
            android:id="@+id/cinemax_splash_streak_two"
            android:layout_width="470dp"
            android:layout_height="1dp"
            android:layout_gravity="center"
            android:background="@drawable/cinemax_splash_light_streak"
            android:rotation="-24" />

        <LinearLayout
            android:id="@+id/cinemax_splash_lockup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/cinemax_splash_emblem"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:contentDescription="@string/splash_emblem_desc"
                android:src="@drawable/cinemax_emblem" />

            <TextView
                style="@style/CinemaxWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/app_name" />

            <TextView
                style="@style/CinemaxTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/splash_tagline" />
        </LinearLayout>
    </FrameLayout>

    <!-- Native offline / error surface with a retry path. -->
    <LinearLayout
        android:id="@+id/cinemax_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cinemax_splash_background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="34dp"
        android:paddingRight="34dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@null"
            android:src="@drawable/cinemax_ic_offline" />

        <TextView
            style="@style/CinemaxErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/error_offline_title" />

        <TextView
            android:id="@+id/cinemax_error_message"
            style="@style/CinemaxErrorBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/error_offline_body" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cinemax_retry"
                style="@style/CinemaxActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/cinemax_button_primary"
                android:text="@string/error_retry" />

            <TextView
                android:id="@+id/cinemax_open_browser"
                style="@style/CinemaxActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/cinemax_button_ghost"
                android:text="@string/error_open_browser" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
