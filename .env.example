# Copy this file to .env.local for local development.
# On Vercel, add these in Project → Settings → Environment Variables.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, Railway, ...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Secret used to sign admin login tokens. Use a long random string.
# Generate one with:  openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Admin panel login (/gate-keeper)
ADMIN_EMAIL="admin@cinemax.com"
ADMIN_PASSWORD="change-me"

# Optional: enable public playback of admin-authorized magnet sources.
# Point this at a persistent, private torrent streaming gateway. The Cinemax
# API forwards Range requests and the approved magnet in a server-only header.
TORRENT_STREAMING_ENABLED="false"
TORRENT_GATEWAY_URL="https://your-private-gateway.example/v1/stream"
TORRENT_GATEWAY_TOKEN="replace-with-a-long-random-secret"
