# Copy to .env.local for local development. Never commit real credentials.

# PostgreSQL connection string (Neon, Supabase, Railway, local Postgres, etc.).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# POSTGRES_URL is accepted as a fallback if DATABASE_URL is not set.

# The default runtime bootstrap creates additive MiLey tables on first use.
# For production, apply `npm run db:push` first, then set this to false so
# web instances do not need DDL privileges.
MILEY_SCHEMA_AUTO_CREATE="true"

# Canonical HTTPS origin used in verification and password-reset emails.
# Use http://localhost:3000 during local development.
MILEY_APP_URL="http://localhost:3000"

# Optional account email delivery via Resend HTTP API (no SMTP).
# RESEND_API_KEY="re_..."
# MILEY_MAIL_FROM="MiLey <accounts@example.com>"

# Optional private S3-compatible audio storage. Keep the bucket private and
# configure CORS for the exact app origin, method PUT, and Content-Type header.
# S3_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
# S3_BUCKET="miley-audio"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."

# Legacy CinemaX studio only; not used for MiLey user accounts.
# JWT_SECRET="generate-a-long-random-secret"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me"
